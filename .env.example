# PostgreSQL connection for local development. Uses psycopg version 3.
DATABASE_URL=postgresql+psycopg://hcvf:password@localhost:5432/hcvf

# Redis database used by API health checks, rate limiting, and distributed locking.
REDIS_URL=redis://localhost:6379/0

# Redis database used as the Celery broker.
CELERY_BROKER_URL=redis://localhost:6379/1

# Redis database used for Celery task results.
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# HTTP header used for tenant API-key authentication.
API_KEY_HEADER=X-API-Key

# Comma-separated development API keys. Replace before any non-local deployment.
HCVF_API_KEYS=dev-hcvf-key

# Runtime environment label used by application configuration.
ENVIRONMENT=development

# Structured logging level.
LOG_LEVEL=INFO

# Maximum protected API requests allowed within one rate-limit window.
RATE_LIMIT_REQUESTS=120

# Rate-limit window size in seconds.
RATE_LIMIT_WINDOW_SECONDS=60

# Scheduler polling interval in seconds.
SCHEDULER_INTERVAL_SECONDS=5
