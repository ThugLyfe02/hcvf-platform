# PostgreSQL connection for local development. Uses psycopg version 3.
DATABASE_URL=postgresql+psycopg://hcvf:password@localhost:5432/hcvf

# Redis database used by API health checks, rate limiting and the Celery broker.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# HTTP header used for tenant API-key authentication.
API_KEY_HEADER=X-API-Key

# Comma-separated bootstrap API keys. These are provisioned as *admin* tenants on
# startup; every other key is minted by the tenant API. Replace before deploying.
HCVF_API_KEYS=dev-hcvf-key

# Runtime environment label. `development` also enables local authorized targets.
ENVIRONMENT=development

LOG_LEVEL=INFO

# Rate limiting (disabled automatically in tests).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Scheduler loop interval.
SCHEDULER_INTERVAL_SECONDS=5

# --- Agentic engine ---------------------------------------------------------
# Default request budget and politeness ceiling for a hunt.
HUNT_BUDGET_REQUESTS=200
HUNT_MAX_RPS=5
HUNT_LEASE_SECONDS=600
HUNT_TIMEOUT_SECONDS=300

# Content-addressed evidence store (mount a volume in production).
EVIDENCE_DIR=evidence

# HMAC key used to sign evidence manifests. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EVIDENCE_KEY=

# --- Governance and transport hardening -------------------------------------
MAX_REQUEST_BYTES=1048576
LOG_REDACTION=true
IDEMPOTENCY_TTL_HOURS=24
QUOTA_ENFORCED=true
WEBHOOK_TIMEOUT_SECONDS=5
RLS_ENFORCED=false

# --- Autonomy ---------------------------------------------------------------
# Global controller switch. Even when true, a tenant needs an approved policy.
AUTONOMY_ENABLED=false
AUTONOMY_INTERVAL_SECONDS=60
AUTONOMY_DEFAULT_BUDGET_REQUESTS=120

# Permit the engine to reach private/loopback addresses. Development only:
# when false, the egress guard blocks RFC1918, loopback and cloud metadata.
ALLOW_PRIVATE_TARGETS=false
